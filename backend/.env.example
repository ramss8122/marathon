# ══════════════════════════════════════════════════════════════════════════════
# RUNTRUST MARATHON ENVIRONMENT CONFIGURATION TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════

# Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/runtrust_marathon

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret (long random string, 32+ characters)
JWT_SECRET=c8d45f9a7b1e3c2d6f8a0b5e4d3c2b1a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c

# Administrative Username
ADMIN_USERNAME=admin

# Administrative Password Bcrypt Hash (single-quoted to prevent shell interpretation of $ characters)
# To generate a new bcrypt hash for a password, run:
# node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH='$2b$10$amIOoj4rxwlz5m3pOjU5auxN67OJi/urVMRgqifgBx6MjrwWLaO8q'
# ══════════════════════════════════════════════════════════════════════════════
# SMTP & EMAIL MARKETING CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
MAIL_FROM_NAME=India RunTrust
MAIL_FROM_ADDRESS=noreply@runtrust.org

# ══════════════════════════════════════════════════════════════════════════════
# RAZORPAY PAYMENT GATEWAY (TEST MODE)
# ══════════════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

